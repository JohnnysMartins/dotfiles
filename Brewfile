# Homebrew packages (curated)
# Run: brew bundle --file=Brewfile

# Formulae
brew "fd"                 # fast find, used by the nvim file pickers
brew "fish"
brew "fzf"                # fuzzy finder backing fzf-lua in nvim
brew "gh"
brew "go"                 # gopls needs a real toolchain
brew "hadolint"           # Dockerfile linter (no arm64 release, so not via Mason)
brew "htop"
brew "lazygit"            # <leader>gg in nvim, and the tds layout
brew "mkcert"
brew "neovim"
brew "node"
brew "ripgrep"            # grep backend for nvim live_grep
brew "rustup"             # provides rust-analyzer via `rustup component add`
brew "spaceship"
brew "tig"
brew "tmux"
brew "zsh"
brew "zsh-autocomplete"
brew "zsh-autosuggestions"
brew "zsh-git-prompt"
brew "zsh-syntax-highlighting"

